# 发布版本号 -- 例 V2023.4.19.1 ： 2023.4.19: 发布时间 ，1: 今天第几次发布
VUE_APP_PUBLISH_VERSION = 'V2025.9.05.1'


VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 请求url前缀
VUE_APP_MDM_BASE_URL = '/mdm'
VUE_APP_SYSTEM_BASE_URL = '/system'
VUE_APP_INFORMATION_BASE_URL = '/information'
VUE_APP_AUTH_BASE_URL = '/gfs-auth'
VUE_APP_OMS_BASE_URL = '/oms'
VUE_APP_ICS_BASE_URL = '/ics'
VUE_APP_ENV = 'uat'
